{
	"info": {
		"_postman_id": "hisaab-khata-phase1-6",
		"name": "HisaabKhata Phase 1-6",
		"description": "Production-ready collection for all Phase 1-6 endpoints. Request/response from controller DTOs. Runner order: Health → Auth → Me → Parties → Categories → Products → Stock → Purchase → Sales → Ledger → Reports.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{accessToken}}", "type": "string" }
		]
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" }
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"var d = new Date();",
					"var today = d.toISOString().slice(0, 10);",
					"if (typeof pm.environment !== 'undefined') { pm.environment.set('today', today); }"
				],
				"type": "text/javascript"
			}
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "GET /health - Liveness",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/health",
						"description": "Liveness. Returns ApiResponse with data: { status: 'UP' }."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const j = pm.response.json();",
									"pm.test('Has success and data', () => { pm.expect(j.success).to.be.true; pm.expect(j.data).to.have.property('status'); });"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "POST /auth/register - Register shop",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shopName\": \"Test Shop\",\n  \"ownerName\": \"Owner Name\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{baseUrl}}/auth/register",
						"description": "Register new shop. Request: RegisterRequest (shopName, ownerName, mobile, password). Response: ApiResponse + AuthResponse (shopId, userId, token, refreshToken)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 201', () => pm.response.to.have.status(201));",
									"const j = pm.response.json();",
									"pm.test('Has success and data', () => { pm.expect(j.success).to.be.true; pm.expect(j.data).to.be.an('object'); });",
									"if (j.data && j.data.token) { pm.environment.set('accessToken', j.data.token); }",
									"if (j.data && j.data.refreshToken) { pm.environment.set('refreshToken', j.data.refreshToken); }",
									"if (j.data && j.data.shopId) { pm.environment.set('shopId', j.data.shopId); }",
									"if (j.data && j.data.userId) { pm.environment.set('ownerUserId', j.data.userId); }"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "POST /auth/login - Login",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{baseUrl}}/auth/login",
						"description": "Login. Request: LoginRequest (mobile, password). Response: ApiResponse + AuthResponse."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const j = pm.response.json();",
									"pm.test('Has success and data', () => { pm.expect(j.success).to.be.true; pm.expect(j.data).to.be.an('object'); });",
									"if (j.data && j.data.token) { pm.environment.set('accessToken', j.data.token); }",
									"if (j.data && j.data.refreshToken) { pm.environment.set('refreshToken', j.data.refreshToken); }",
									"if (j.data && j.data.shopId) { pm.environment.set('shopId', j.data.shopId); }",
									"if (j.data && j.data.userId) { pm.environment.set('ownerUserId', j.data.userId); }"
								],
								"type": "text/javascript"
							}
